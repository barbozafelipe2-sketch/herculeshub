# Configure these in the hosting secret manager; never commit real values.
PUBLIC_ORIGIN=https://api.your-domain.example
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/data/hercules-commercial.sqlite
# Generate 32 random bytes as 64 hexadecimal characters; preserve securely across restarts.
DATA_ENCRYPTION_KEY=
APPLE_BUNDLE_ID=
APPLE_ENVIRONMENT=Sandbox
# Required in Production. Use separate Sandbox/Production services and databases.
APPLE_APP_ID=
APPLE_PRODUCT_IDS=
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_KEY_PATH=/run/secrets/apple-signin.p8
APPLE_STORE_KEY_ID=
APPLE_STORE_ISSUER_ID=
APPLE_STORE_KEY_PATH=/run/secrets/apple-store.p8
# Comma-separated paths to Apple PKI root certificates in DER format.
APPLE_ROOT_CERTIFICATE_PATHS=/run/certificates/AppleRootCA-G3.cer
# Optional UUIDs of verified commercial accounts authorized to acknowledge ordinary owner reviews.
REVIEWER_ACCOUNT_IDS=

